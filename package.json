    "express-graphql": "^0.12.0",
    "graphql": "^15.9.0",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.468.0",
    "next": "15.3.4",
    "openai": "^6.5.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.3.0",
    "slate": "^0.117.2",
